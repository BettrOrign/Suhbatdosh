# Gemini API
GEMINI_API_KEY=your_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash

# Data dirs (relative to backend/)
DATA_DIR=../data

# Admin bootstrap account (used only to auto-seed on first run)
ADMIN_EMAIL=admin@suhbatdosh.uz
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ENABLED=false

# Environment: "" / dev  -> demo users + demo calls are seeded (local dev)
#              prod         -> demo accounts are NEVER created; set APP_ENV=prod
APP_ENV=
SEED_DEMO_USERS=
SEED_DEMO_CALLS=

# Browser origins allowed to call the API. Comma-separated. Unset => "*".
# Set this in production, e.g.:
# CORS_ORIGINS=https://suhbatdosh.uz,https://suhbatdoshai.uz
CORS_ORIGINS=

# Shared secret for POST /api/zadarma/webhook. While unset the webhook is
# disabled and returns 503 (Zadarma has no session token to send).
ZADARMA_WEBHOOK_SECRET=

# Offline STT for private mode. Defaults to <repo>/local-stt/model.
LOCAL_STT_MODEL_DIR=
LOCAL_STT_THREADS=8
